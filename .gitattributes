###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

###############################################################################
# GitHub Linguist Overrides (Force 100% C#)
###############################################################################
# 1. Repodaki her şeyi dil istatistiğinden hariç tut
* linguist-vendored

# 2. Sadece C# ve Razor dosyalarını istatistiğe aç
*.cs linguist-vendored=false
*.cs linguist-detectable=true

*.cshtml linguist-vendored=false
*.cshtml linguist-detectable=true
*.cshtml linguist-language=C#
