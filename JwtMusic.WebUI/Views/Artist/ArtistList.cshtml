@model IReadOnlyCollection<ArtistViewModel>
@{ ViewData["Title"] = "Sanatçılar"; }
<div class="page-container py-5"><h1 class="mb-5">Sanatçılar</h1><div class="row">
@foreach (var artist in Model) { <div class="col-6 col-md-4 col-lg-3 mb-5 text-center"><a asp-action="Detail" asp-route-id="@artist.ArtistId"><img class="artist-avatar" src="@artist.ArtistImageUrl" alt="@artist.ArtistName"/><h5 class="mt-3 text-white">@artist.ArtistName @if(artist.IsVerified){<span class="text-primary">●</span>}</h5><span class="text-muted">@artist.Country · @artist.Songs.Count şarkı</span></a></div> }
</div></div>
