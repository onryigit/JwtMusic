@model IReadOnlyCollection<ArtistViewModel>
@{ ViewData["Title"] = "Sanatçılar"; }
<div class="page-container py-5"><div class="section-heading"><span class="eyebrow">KATALOĞUN SESLERİ</span><h1>Sanatçılar</h1><p>Türkiye'den ve dünyadan @Model.Count sanatçı.</p></div><div class="row mt-5">
@foreach (var artist in Model){<div class="col-6 col-md-4 col-lg-3 mb-5 text-center artist-tile"><a asp-action="Detail" asp-route-id="@artist.ArtistId"><img class="artist-avatar" src="@artist.ArtistImageUrl" alt="@artist.ArtistName"/><h5 class="mt-3 text-white">@artist.ArtistName @if(artist.IsVerified){<span class="verified">✓</span>}</h5><span class="text-muted">@artist.Country · @artist.Songs.Count şarkı</span></a></div>}
</div></div>
