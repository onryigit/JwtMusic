@model ArtistViewModel
@{ ViewData["Title"] = Model.ArtistName; }
<div class="page-container py-5"><section class="artist-hero mb-5" style="background-image:url('@Model.CoverImageUrl')"><div><img src="@Model.ArtistImageUrl" class="artist-avatar"/><h1>@Model.ArtistName</h1><p>@Model.Bio</p></div></section><h3>Şarkıları</h3><div class="track-list">
@foreach(var song in Model.Songs){<div class="track-row"><img src="@song.CoverImageUrl"/><div class="flex"><a class="text-white" asp-controller="Songs" asp-action="Detail" asp-route-id="@song.SongId">@song.SongName</a><small>@song.AlbumName · @song.GenreName</small></div><span class="badge badge-package">@song.RequiredPackage</span><button class="btn btn-primary btn-sm rounded-circle" onclick="playSong(@song.SongId, '@song.SongName', '@song.ArtistName', '@song.CoverImageUrl')">▶</button></div>}
</div></div>
