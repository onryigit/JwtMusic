@model JwtMusic.WebUI.Dtos.LoginDto
@{ Layout = null; }
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Giriş yap · Bepop</title>
    <link rel="stylesheet" href="~/Bepop/assets/css/bootstrap.css" /><link rel="stylesheet" href="~/Bepop/assets/css/theme.css" /><link rel="stylesheet" href="~/Bepop/assets/css/style.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-row bg-dark auth-body">
<main class="auth-shell">
    <section class="auth-art"><div class="auth-art-shade"><a class="navbar-brand text-white" href="#"><span class="brand-record">B</span> Bepop</a><div><span class="eyebrow">MÜZİK SENİNLE</span><h1>Dinlemeye<br />kaldığın yerden devam et.</h1><p>Sevdiğin şarkıları keşfet, listelerini oluştur ve dinleme geçmişine her yerden ulaş.</p></div><small>60 seçili parça · Kişisel öneriler · Kesintisiz keşif</small></div></section>
    <section class="auth-form-panel"><div class="auth-card">
        <h2>Tekrar hoş geldin</h2><p class="text-muted mb-4">Hesabına giriş yaparak müziğe devam et.</p>
        @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
        @if (ViewData.ModelState.TryGetValue(string.Empty, out var loginState) && loginState.Errors.Count > 0)
        {
            <div class="alert alert-danger auth-error" role="alert" aria-live="polite">
                @foreach (var error in loginState.Errors)
                {
                    <div>@(error.ErrorMessage.Length > 0 ? error.ErrorMessage : "Giriş yapılamadı. Lütfen bilgilerinizi kontrol edin.")</div>
                }
            </div>
        }
        <form method="post">
            <div class="form-group"><label asp-for="Username">Kullanıcı adı veya e-posta</label><input asp-for="Username" class="form-control" autocomplete="username" autofocus placeholder="Kullanıcı adınız" /><span asp-validation-for="Username" class="text-danger small"></span></div>
            <div class="form-group"><div class="d-flex justify-content-between"><label asp-for="Password">Parola</label></div><input asp-for="Password" class="form-control" type="password" autocomplete="current-password" placeholder="Parolanız" /><span asp-validation-for="Password" class="text-danger small"></span></div>
            <button class="btn btn-primary btn-block mt-4" type="submit">Giriş yap</button>
        </form>
        <p class="mt-4 mb-0 text-center text-muted">Bepop'a yeni misin? <a asp-controller="Register" asp-action="SignUp">Hesap oluştur</a></p>
    </div></section>
</main>
<script src="~/Bepop/libs/jquery/dist/jquery.min.js"></script><script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script><script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body></html>
