@model SongDetailViewModel
@{ ViewData["Title"] = Model.Song.SongName; }
<div class="page-container py-5"><div class="row"><div class="col-lg-8">
    <section class="song-detail glass-panel"><img src="@Model.Song.CoverImageUrl" alt="@Model.Song.SongName albüm kapağı"/><div><span class="badge badge-package">@Model.Song.RequiredTier</span><h1>@Model.Song.SongName</h1><a asp-controller="Artist" asp-action="Detail" asp-route-id="@Model.Song.ArtistId">@Model.Song.ArtistName</a><p class="text-muted mt-2">@Model.Song.AlbumName · @Model.Song.GenreName · @Model.Song.ListenCount dinleme</p><button class="btn auth-submit js-play" data-id="@Model.Song.SongId" data-title="@Model.Song.SongName" data-artist="@Model.Song.ArtistName" data-cover="@Model.Song.CoverImageUrl">▶ Şimdi dinle</button></div></section>
    <section class="lyrics glass-panel mt-4"><span class="eyebrow">PARÇA HAKKINDA</span><h4>Yayın bilgileri</h4><small>Yayın tarihi: @Model.Song.ReleaseDate.ToString("dd.MM.yyyy")</small>@if (Model.Song.ArtistName == "Josh Woodward") {<small class="d-block mt-2">Müzik: Josh Woodward · <a href="@Model.Song.StoreUrl" target="_blank" rel="noopener">Kaynak</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noopener">CC BY 4.0</a></small>}</section>
</div><aside class="col-lg-4 mt-4 mt-lg-0"><span class="eyebrow">BUNLARI DA DİNLE</span><h3>Önerilenler</h3><p class="text-muted small">Dinleme alışkanlıkları ve benzer türlere göre seçildi.</p><div class="glass-panel">
@foreach(var song in Model.Recommendations){<div class="track-row"><img src="@song.CoverImageUrl" alt="@song.SongName kapağı"/><div class="flex"><a class="text-white" asp-action="Detail" asp-route-id="@song.SongId">@song.SongName</a><small>@song.ArtistName</small></div><button class="btn btn-sm btn-outline-light js-play" data-id="@song.SongId" data-title="@song.SongName" data-artist="@song.ArtistName" data-cover="@song.CoverImageUrl" aria-label="Çal">▶</button></div>}
</div></aside></div></div>
