@model SongDetailViewModel
@{ ViewData["Title"] = Model.Song.SongName; }
<div class="page-container py-5"><div class="row"><div class="col-lg-8"><div class="song-detail"><img src="@Model.Song.CoverImageUrl"/><div><span class="badge badge-package">@Model.Song.RequiredPackage</span><h1>@Model.Song.SongName</h1><a asp-controller="Artist" asp-action="Detail" asp-route-id="@Model.Song.ArtistId">@Model.Song.ArtistName</a><p>@Model.Song.AlbumName · @Model.Song.GenreName · @Model.Song.ListenCount dinleme</p><button class="btn gd-primary text-white" onclick="playSong(@Model.Song.SongId, '@Model.Song.SongName', '@Model.Song.ArtistName', '@Model.Song.CoverImageUrl')">▶ Şimdi Dinle</button></div></div><div class="lyrics mt-5"><h4>Şarkı Bilgisi</h4><p>@Model.Song.Lyrics</p></div></div><aside class="col-lg-4"><h3>Önerilenler</h3><p class="text-muted small">Bu şarkıyı dinleyenlerin tercihlerine göre</p>
@foreach(var song in Model.Recommendations){<div class="track-row"><img src="@song.CoverImageUrl"/><div class="flex"><a class="text-white" asp-action="Detail" asp-route-id="@song.SongId">@song.SongName</a><small>@song.ArtistName</small></div><button class="btn btn-sm btn-outline-light" onclick="playSong(@song.SongId, '@song.SongName', '@song.ArtistName', '@song.CoverImageUrl')">▶</button></div>}
</aside></div></div>
