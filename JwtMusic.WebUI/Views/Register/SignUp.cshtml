@model JwtMusic.WebUI.Dtos.RegisterDto
@{ Layout = null; }
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hesap oluştur · Reverb</title>
    <link rel="stylesheet" href="~/Bepop/assets/css/bootstrap.css" /><link rel="stylesheet" href="~/Bepop/assets/css/theme.css" /><link rel="stylesheet" href="~/Bepop/assets/css/style.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-row bg-dark auth-body">
<main class="auth-shell">
    <section class="auth-art"><div class="auth-art-shade"><a class="navbar-brand text-white" asp-controller="Login" asp-action="SignIn"><partial name="_Brand" /></a><div><span class="eyebrow">KEŞFETMEYE BAŞLA</span><h1>Sana eşlik edecek<br />şarkıları bul.</h1><p>Yeni müzikler keşfet, kendi çalma listelerini hazırla ve dinleme geçmişini tek yerde tut.</p></div><small>Kişisel kütüphane · Akıllı öneriler · Her an yanında</small></div></section>
    <section class="auth-form-panel"><div class="auth-card auth-card-wide">
        <h2>Hesap oluştur</h2><p class="text-muted mb-4">Birkaç adımda Reverb’e katıl.</p>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary-valid"></div>
        <form method="post">
            <div class="form-row"><div class="form-group col"><label asp-for="Name">Ad</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div><div class="form-group col"><label asp-for="Surname">Soyad</label><input asp-for="Surname" class="form-control" /><span asp-validation-for="Surname" class="text-danger small"></span></div></div>
            <div class="form-group"><label asp-for="Username">Kullanıcı adı</label><input asp-for="Username" class="form-control" autocomplete="username" /><span asp-validation-for="Username" class="text-danger small"></span></div>
            <div class="form-group"><label asp-for="Email">E-posta</label><input asp-for="Email" class="form-control" type="email" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="form-group"><label asp-for="Password">Parola</label><input asp-for="Password" class="form-control" type="password" autocomplete="new-password" /><small class="form-text text-muted">En az 6 karakter kullanın.</small><span asp-validation-for="Password" class="text-danger small d-block"></span></div>
            <div class="form-group"><label asp-for="PlanTier">Başlangıç paketi</label><select asp-for="PlanTier" class="form-control plan-select"><option value="1">Basic · Ücretsiz</option><option value="2">Gold · $4.99/ay</option><option value="3">Premium · $9.99/ay</option><option value="4">Elit · $14.99/ay</option></select><small class="form-text text-muted">Test için istediğiniz paketi seçebilirsiniz.</small><span asp-validation-for="PlanTier" class="text-danger small"></span></div>
            <button class="btn btn-primary btn-block mt-4" type="submit">Hesap oluştur</button>
        </form>
        <p class="mt-4 mb-0 text-center text-muted">Zaten hesabın var mı? <a asp-controller="Login" asp-action="SignIn">Giriş yap</a></p>
    </div></section>
</main>
<script src="~/Bepop/libs/jquery/dist/jquery.min.js"></script><script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script><script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body></html>
