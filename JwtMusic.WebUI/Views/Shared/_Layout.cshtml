<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Bepop Music</title>
    <link rel="stylesheet" href="~/Bepop/assets/css/bootstrap.css" />
    <link rel="stylesheet" href="~/Bepop/assets/css/theme.css" />
    <link rel="stylesheet" href="~/Bepop/assets/css/style.css" />
    <link rel="stylesheet" href="~/Bepop/libs/plyr/dist/plyr.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-column bg-dark text-white">
    <header class="page-header fixed">
        <div class="navbar navbar-expand-lg bg-dark">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand text-white">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor"/><circle cx="12" cy="12" r="2" stroke="currentColor"/><path d="M16.2 7.8a6 6 0 010 8.4M7.8 16.2a6 6 0 010-8.4" stroke="currentColor"/></svg>
                <span>Bepop Music</span>
            </a>
            @if (Context.Session.GetString("JwtToken") is not null)
            {
                <nav class="navbar-nav flex-row ml-auto align-items-center">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Keşfet</a>
                    <a class="nav-link" asp-controller="Artist" asp-action="ArtistList">Sanatçılar</a>
                    <a class="nav-link text-danger" asp-controller="Login" asp-action="Logout">Çıkış</a>
                </nav>
            }
        </div>
    </header>
    <main class="page-content">@RenderBody()</main>

    @if (Context.Session.GetString("JwtToken") is not null)
    {
        <section id="music-player" class="player-bar d-none">
            <img id="player-cover" alt="Kapak" />
            <div class="player-meta"><strong id="player-title">—</strong><span id="player-artist">—</span></div>
            <audio id="audio-player" controls preload="none"></audio>
        </section>
        <div class="modal fade" id="packageModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered"><div class="modal-content bg-dark border-danger">
                <div class="modal-header"><h5 class="modal-title">Paket Yetkisi Gerekli</h5><button class="close text-white" data-dismiss="modal">&times;</button></div>
                <div class="modal-body">Mevcut paketiniz bu şarkıyı desteklememektedir. Lütfen paketinizi yükseltin.</div>
            </div></div>
        </div>
    }
    <script src="~/Bepop/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/Bepop/libs/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
