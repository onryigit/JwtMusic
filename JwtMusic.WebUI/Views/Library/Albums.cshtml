@model IReadOnlyCollection<AlbumViewModel>
@{ ViewData["Title"] = "Albümler"; }
<div class="page-container py-5">
    <div class="section-heading"><span class="eyebrow">KOLEKSİYONLAR</span><h1>Albümler</h1><p>Sanatçılar ve albümleri tek yerde.</p></div>
    <div class="row mt-5">
    @foreach (var album in Model) { <div class="col-6 col-md-4 col-lg-3 mb-5"><article class="album-card"><a asp-controller="Artist" asp-action="Detail" asp-route-id="@album.ArtistId"><img src="@album.CoverImageUrl" alt="@album.Name"/><div class="album-vinyl"></div></a><h5 class="mt-3 mb-1">@album.Name</h5><a asp-controller="Artist" asp-action="Detail" asp-route-id="@album.ArtistId" class="text-muted">@album.ArtistName</a><small class="d-block text-muted">@album.ReleaseDate.Year · @album.SongCount şarkı</small></article></div> }
    </div>
</div>
