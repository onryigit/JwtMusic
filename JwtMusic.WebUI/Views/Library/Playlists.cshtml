@model LibraryViewModel
@{ ViewData["Title"] = "Listelerim"; }
<div class="page-container py-5"><div class="d-flex flex-wrap justify-content-between align-items-end"><div class="section-heading"><span class="eyebrow">KİŞİSEL KOLEKSİYON</span><h1>Listelerim</h1><p>Sevdiğin parçaları bir araya getir.</p></div><button class="btn auth-submit" data-toggle="collapse" data-target="#newPlaylist">+ Yeni liste</button></div>
<div id="newPlaylist" class="collapse glass-panel mt-4"><form asp-action="CreatePlaylist" method="post"><div class="form-group"><label>Liste adı</label><input class="form-control" name="name" required maxlength="80" placeholder="Örn. Gece Yolculuğu" /></div><label>Şarkılar</label><div class="song-picker">@foreach(var song in Model.Songs){<label><input type="checkbox" name="songIds" value="@song.SongId"/><img src="@song.CoverImageUrl" alt=""/><span>@song.SongName<small>@song.ArtistName</small></span></label>}</div><button class="btn auth-submit mt-3" type="submit">Listeyi oluştur</button></form></div>
@if(TempData["Success"] is string success){<div class="alert alert-success mt-4">@success</div>} @if(TempData["Error"] is string error){<div class="alert alert-danger mt-4">@error</div>}
<div class="row mt-5">@if(!Model.Playlists.Any()){<div class="col-12 empty-state glass-panel"><span>♪</span><h3>Henüz bir listen yok</h3><p>İlk koleksiyonunu birkaç saniyede oluştur.</p></div>} @foreach(var list in Model.Playlists){<div class="col-lg-6 mb-4"><section class="glass-panel playlist-card"><div class="d-flex justify-content-between"><div><span class="eyebrow">ÇALMA LİSTESİ</span><h3>@list.Name</h3></div><strong>@list.Songs.Count parça</strong></div>@foreach(var song in list.Songs){<div class="track-row"><img src="@song.CoverImageUrl" alt=""/><div class="flex"><a class="text-white" asp-controller="Songs" asp-action="Detail" asp-route-id="@song.SongId">@song.SongName</a><small>@song.ArtistName</small></div><button class="btn btn-sm btn-outline-light js-play" data-id="@song.SongId" data-title="@song.SongName" data-artist="@song.ArtistName" data-cover="@song.CoverImageUrl">▶</button></div>}</section></div>}</div></div>
