@model IReadOnlyCollection<GenreViewModel>
@{ ViewData["Title"] = "Türler"; var colors = new[] { "#6c5ce7", "#0984e3", "#e84393", "#e17055", "#00b894", "#4f46e5", "#a16207" }; }
<div class="page-container py-5"><div class="section-heading"><span class="eyebrow">TARZINI BUL</span><h1>Müzik türleri</h1><p>Ruh haline uygun parçaları keşfet.</p></div><div class="row mt-5">
@for (var i = 0; i < Model.Count; i++){var genre=Model.ElementAt(i);<div class="col-sm-6 col-lg-4 mb-4"><a class="genre-card" style="--genre-color:@colors[i % colors.Length]" asp-controller="Home" asp-action="Index" asp-route-genreId="@genre.GenreId"><span>0@(i+1)</span><h2>@genre.Name</h2><p>@genre.SongCount şarkı</p><b>Keşfet →</b></a></div>}
</div></div>
